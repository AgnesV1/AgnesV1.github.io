---
import { GITHUB_URL, INSTAGRAM_URL, SITE_TITLE, YOUTUBE_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

// 站名是「英文名 ／ 中文名」的组合字标，中间的全角斜杠上色作点缀
const [titleEn, titleZh] = SITE_TITLE.split('／').map((s) => s.trim());

// 英文名拆成一个个字母，鼠标停上去时挨个扑一下翅膀（每个字母扑起来时短暂换成五色之一）
const FLAP = ['coral', 'mint', 'lav', 'sun', 'sky'];
const letters = [...titleEn];
---

<header>
	<!-- 下拉后浮现的迷你页头：小号淡色站名固定在最上端，点击回首页 -->
	<a class="mini-bar" id="mini-bar" href="/" aria-hidden="true" tabindex="-1">
		SKYLARKING <span class="dot">·</span> 荒腔走板
	</a>
	<nav>
		<a class="logo" href="/">
			<span class="flap" aria-hidden="true">{letters.map((ch, i) => <span class="ch" style={`--i:${i};--fc:var(--${FLAP[i % 5]})`}>{ch}</span>)}</span><span class="sr-only">{titleEn}</span>
			{titleZh ? <> <span class="slash">／</span> {titleZh}</> : <span class="slash">.</span>}
		</a>
		<!-- 桌面端平铺在页头里；小屏折叠进汉堡菜单面板 -->
		<div class="menu" id="site-menu">
			<div class="links">
				<HeaderLink href="/"><span class="only-zh">致云雀</span><span class="only-en">Notes</span></HeaderLink>
				<HeaderLink href="/writing"><span class="only-zh">夜莺颂</span><span class="only-en">Fiction</span></HeaderLink>
				<HeaderLink href="/photos"><span class="only-zh">镜花水月</span><span class="only-en">Photos</span></HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<span class="nav-bar" aria-hidden="true"></span>
			</div>
			<div class="social">
				{
					YOUTUBE_URL && (
						<a href={YOUTUBE_URL} target="_blank" class="icon yt">
							<span class="sr-only">YouTube 频道</span>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
								<path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12c0 1.9.2 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.3-1.9.5-3.9.5-5.8s-.2-3.9-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z" />
							</svg>
						</a>
					)
				}
				{
					INSTAGRAM_URL && (
						<a href={INSTAGRAM_URL} target="_blank" class="icon ig">
							<span class="sr-only">Instagram</span>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<rect x="2.5" y="2.5" width="19" height="19" rx="5.2" />
								<circle cx="12" cy="12" r="4.4" />
								<circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
							</svg>
						</a>
					)
				}
				{
					GITHUB_URL && (
						<a href={GITHUB_URL} target="_blank" class="icon gh">
							<span class="sr-only">GitHub 主页</span>
							<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
							</svg>
						</a>
					)
				}
				<a href="/rss.xml" class="icon rss">
					<span class="sr-only">RSS 订阅</span>
					<svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
						<path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56Zm0 5.66v2.83a7.07 7.07 0 0 1 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9ZM6 16a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
					</svg>
				</a>
			</div>
		</div>
		<div class="controls">
			<LangToggle />
			<ThemeToggle />
			<button id="menu-btn" class="menu-btn icon" aria-label="菜单" aria-expanded="false" aria-controls="site-menu">
				<svg class="i-open" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<line x1="4" y1="6.5" x2="20" y2="6.5"></line>
					<line x1="4" y1="12" x2="20" y2="12"></line>
					<line x1="4" y1="17.5" x2="20" y2="17.5"></line>
				</svg>
				<svg class="i-close" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<line x1="6" y1="6" x2="18" y2="18"></line>
					<line x1="18" y1="6" x2="6" y2="18"></line>
				</svg>
			</button>
		</div>
	</nav>
</header>

<style>
	header {
		width: 100%;
	}
	/* 迷你页头：比页头字标明显小、颜色淡，毛玻璃底固定在视口顶端；
	   默认藏在上方，页头字标滚出视口后滑入（脚本用 IntersectionObserver 切换） */
	.mini-bar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 45;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.15rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		color: var(--tx-2);
		text-decoration: none;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		border-bottom: 1px solid var(--line);
		opacity: 0;
		transform: translateY(-100%);
		pointer-events: none;
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}
	.mini-bar.show {
		opacity: 1;
		transform: none;
		pointer-events: auto;
		/* 毛玻璃只在可见时启用，藏着的时候不占合成层 */
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.mini-bar:hover {
		color: var(--tx);
	}
	.mini-bar .dot {
		color: var(--coral);
		margin: 0 0.45em;
	}
	@media (prefers-reduced-motion: reduce) {
		.mini-bar {
			transition: opacity 0.25s ease;
			transform: none;
		}
	}
	nav {
		max-width: 44rem;
		margin-inline: auto;
		padding: 1.2rem 1.25rem 1rem;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		row-gap: 0.55rem;
	}
	/* 站名较长，独占页头第一行；导航和图标排在第二行 */
	.logo {
		flex-basis: 100%;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.05rem, 4vw, 1.35rem);
		letter-spacing: -0.01em;
		white-space: nowrap;
		color: var(--tx);
		text-decoration: none;
	}
	.logo .slash {
		color: var(--coral);
	}
	/* 站名扑翅：鼠标停上去时字母挨个起落——上移 7px、转 -4°、短暂变成五色之一，
	   错开 38ms、每个 0.7s。只在悬停的那一下动（脚本加 .flapping、最后一个字母落地后拿掉，
	   所以中途移开也会把这一轮放完，不会半空弹回去）；系统要求减少动态时不动。 */
	.logo .ch {
		display: inline-block;
	}
	@media (prefers-reduced-motion: no-preference) {
		.logo.flapping .ch {
			animation: flap 0.7s cubic-bezier(0.3, 0.7, 0.4, 1) both;
			animation-delay: calc(var(--i) * 38ms);
		}
	}
	@keyframes flap {
		0%,
		100% {
			transform: none;
			color: var(--tx);
		}
		32% {
			transform: translateY(-7px) rotate(-4deg);
			color: var(--fc);
		}
		58% {
			color: var(--fc);
		}
		78% {
			transform: translateY(0.5px) rotate(0.6deg);
		}
	}
	/* 桌面端 .menu 不产生盒子，links / social 直接排进页头一行 */
	.menu {
		display: contents;
	}
	.links {
		display: flex;
		align-items: baseline;
		gap: 1.1rem;
		margin-left: auto;
		white-space: nowrap;
	}
	/* 栏目下面那一道线会滑：脚本给 .links 加上 .sliding 后，各个链接自己的下划线藏起来，
	   换成同一道 .nav-bar——停在当前栏目时是珊瑚色，鼠标移到别的栏目就滑过去、变薄荷色，移开再滑回来。
	   没有当前栏目的页面（文章页、404）平时不显示，鼠标移上来才出现。只在宽屏（页头一行排开时）用；
	   没有脚本或系统要求减少动态时是原来的样子 / 直接跳。 */
	.links {
		position: relative;
	}
	.nav-bar {
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 2px;
		opacity: 0;
		pointer-events: none;
		background: var(--coral);
		transition:
			transform 0.34s cubic-bezier(0.32, 0.72, 0, 1),
			width 0.34s cubic-bezier(0.32, 0.72, 0, 1),
			background-color 0.25s ease,
			opacity 0.2s ease;
	}
	.nav-bar.away {
		background: var(--mint);
	}
	.links.sliding .nav-bar.show {
		opacity: 1;
	}
	.links.sliding :global(a),
	.links.sliding :global(a:hover),
	.links.sliding :global(a.active) {
		border-bottom-color: transparent;
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-bar {
			transition: none;
		}
	}
	.social {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin-left: 1.1rem;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.icon {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.45rem;
		border-radius: 50%;
		color: var(--tx-2);
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}
	.icon.gh:hover {
		color: var(--lav);
		background: color-mix(in srgb, var(--lav) 14%, transparent);
	}
	.icon.yt:hover {
		color: var(--coral);
		background: color-mix(in srgb, var(--coral) 14%, transparent);
	}
	.icon.ig:hover {
		color: var(--coral);
		background: color-mix(in srgb, var(--coral) 14%, transparent);
	}
	.icon.rss:hover {
		color: var(--sun);
		background: color-mix(in srgb, var(--sun) 14%, transparent);
	}
	.menu-btn {
		display: none;
		border: none;
		background: none;
		cursor: pointer;
	}
	.menu-btn:hover {
		color: var(--tx);
		background: color-mix(in srgb, var(--sky) 14%, transparent);
	}
	.menu-btn .i-close {
		display: none;
	}

	/* 小屏：页头只留 logo + 语言/主题切换 + 汉堡按钮，菜单折叠成面板 */
	@media (max-width: 640px) {
		.menu-btn {
			display: flex;
		}
		.controls {
			margin-left: auto;
		}
		.menu {
			display: none;
			/* 排在 logo 和右侧按钮组之后，展开时占满一整行、把内容往下推 */
			order: 10;
			flex-basis: 100%;
			min-width: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
			margin-top: 1rem;
			padding-top: 0.9rem;
			border-top: 1px solid var(--line);
		}
		nav.open .menu {
			display: flex;
			animation: menu-in 0.22s ease;
		}
		nav.open .menu-btn .i-open {
			display: none;
		}
		nav.open .menu-btn .i-close {
			display: block;
		}
		.links {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
			margin-left: 0;
		}
		.nav-bar {
			display: none;
		}
		/* 面板里的链接加大，方便手指点按 */
		.links :global(a) {
			font-size: 1.05rem;
			padding: 0.3rem 0.1rem;
		}
		.social {
			margin-left: -0.3rem;
			gap: 0.4rem;
		}
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		nav.open .menu {
			animation: none;
		}
	}
</style>

<script>
	const btn = document.getElementById('menu-btn');
	const nav = btn?.closest('nav');
	const setOpen = (open: boolean) => {
		nav?.classList.toggle('open', open);
		btn?.setAttribute('aria-expanded', String(open));
	};
	btn?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setOpen(false);
	});

	// 站名扑翅：鼠标移上来（或键盘聚焦）时放一轮，最后一个字母落地后收工；放的中途再移上来不重放
	const flapLogo = document.querySelector<HTMLElement>('header .logo');
	const lastLetter = flapLogo?.querySelector('.ch:last-child');
	if (flapLogo && lastLetter) {
		const flap = () => flapLogo.classList.add('flapping');
		flapLogo.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && flap());
		flapLogo.addEventListener('focus', () => flapLogo.matches(':focus-visible') && flap());
		lastLetter.addEventListener('animationend', () => flapLogo.classList.remove('flapping'));
	}

	// 栏目下划线滑动：只在宽屏、页头一行排开时启用；换语言（栏目名变长变短）、窗口变宽窄、字体到位时重新量
	const links = document.querySelector<HTMLElement>('header .links');
	const navBar = links?.querySelector<HTMLElement>('.nav-bar');
	if (links && navBar) {
		const wide = matchMedia('(min-width: 641px)');
		const anchors = [...links.querySelectorAll<HTMLAnchorElement>('a')];
		const current = () => anchors.find((a) => a.classList.contains('active')) ?? null;
		const place = (a: HTMLAnchorElement | null, instant = false) => {
			// 原本藏着（没有当前栏目的页面）时，先就位再淡出来，不从左边滑过来
			const jump = instant || !navBar.classList.contains('show');
			if (jump) navBar.style.transition = instant ? 'none' : 'opacity 0.2s ease';
			if (a) {
				navBar.style.width = `${a.offsetWidth}px`;
				navBar.style.transform = `translate(${a.offsetLeft}px, ${a.offsetTop + a.offsetHeight - 2}px)`;
			}
			navBar.classList.toggle('show', !!a);
			navBar.classList.toggle('away', !!a && a !== current());
			if (jump) {
				void navBar.offsetWidth;
				navBar.style.transition = '';
			}
		};
		const setup = () => {
			links.classList.toggle('sliding', wide.matches);
			if (wide.matches) place(current(), true);
		};
		anchors.forEach((a) => a.addEventListener('pointerenter', () => wide.matches && place(a)));
		links.addEventListener('pointerleave', () => wide.matches && place(current()));
		wide.addEventListener('change', setup);
		document.addEventListener('langchange', setup);

		// 换语言时，三个栏目名先乱一下再落成新名字（约 0.4 秒，从左往右一个字一个字定下来），页面其余部分照常交叉淡化。
		// 落成中文时乱的是本站自己的字（云雀、夜莺、镜花水月……），落成英文时是小写字母——字宽和目标差不多，导航不乱跳。
		// 只有栏目名这样；减少动态时不乱。临时用一个 setInterval，放完就清掉。
		const ZH = '云雀夜莺颂镜花水月荒腔走板星尘风铃天光梦诗';
		const EN = 'abcdefghijklmnopqrstuvwxyz';
		const scramble = () => {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			const lang = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
			const pool = lang === 'zh' ? ZH : EN;
			links.querySelectorAll<HTMLElement>(`a .only-${lang}`).forEach((el) => {
				const to = (el.dataset.label ??= el.textContent ?? '');
				const chars = [...to];
				let step = 0;
				const id = setInterval(() => {
					step++;
					const keep = Math.floor((chars.length * step) / 9);
					el.textContent =
						chars.slice(0, keep).join('') + chars.slice(keep).map(() => pool[Math.floor(Math.random() * pool.length)]).join('');
					if (step >= 9) {
						clearInterval(id);
						el.textContent = to;
						if (wide.matches) place(current(), true);
					}
				}, 42);
			});
		};
		document.addEventListener('langchange', scramble);
		addEventListener('resize', setup);
		document.fonts?.ready.then(setup);
		setup();
	}

	// 页头字标滚出视口 → 迷你页头滑入顶端；滚回来 → 迷你页头退场
	const miniBar = document.getElementById('mini-bar');
	const logo = document.querySelector('header .logo');
	if (miniBar && logo) {
		new IntersectionObserver(
			([entry]) => {
				const show = !entry.isIntersecting;
				miniBar.classList.toggle('show', show);
				miniBar.setAttribute('aria-hidden', String(!show));
				(miniBar as HTMLAnchorElement).tabIndex = show ? 0 : -1;
			},
			{ rootMargin: '-1px 0px 0px 0px' },
		).observe(logo);
	}
</script>
