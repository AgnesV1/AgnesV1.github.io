---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/og.png' } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- 主题与语言初始化：必须在样式生效前运行，避免闪烁。
     日夜跟着钟点走：当地时间 6 点到 18 点是日间，其余是夜间；点过页头那颗日月的（theme-hold = { v, until }）照点的来，管到下一个六点。
     同一条规则在 ThemeToggle.astro 的脚本里还有一份（页面开着过六点时用），改要一起改。 -->
<script is:inline>
	(() => {
		const now = new Date();
		const h = now.getHours();
		let theme = h >= 6 && h < 18 ? 'light' : 'dark';
		let lang = 'zh';
		try {
			localStorage.removeItem('theme'); // 以前存的是永久的选择，留着会盖住钟点
			const hold = JSON.parse(localStorage.getItem('theme-hold') || 'null');
			if (hold && (hold.v === 'light' || hold.v === 'dark') && now.getTime() < Number(hold.until)) theme = hold.v;
			lang = localStorage.getItem('lang') ?? 'zh';
		} catch {
			/* 读不了本地存储：照钟点、默认中文 */
		}
		document.documentElement.dataset.theme = theme;
		document.documentElement.dataset.lang = lang;
	})();

	// 天色跟着钟点（global.css 的「全站底图」拿去画，比苦昼短淡一档）：
	// 白天早上偏暖（杏、浅玫瑰）、白天是平常那抹淡蓝、傍晚偏薰衣草和粉、六点前地平线一点杏黄；
	// 夜里刚入夜带紫、地平线一抹玫瑰，后半夜最深（只剩星云），天亮前顶上泛蓝、地平线泛青。
	// 每张表一行 = [钟点, 天顶颜色, 地平线颜色]（rgba），关键时刻之间按钟点线性过渡。白天夜里两套都算好写在 <html> 上，
	// 点日月换了白天 / 夜里也不用重算：白天那套在夜里的钟点用正午的天，夜里那套在白天的钟点用凌晨一点的天。
	// Sky.astro 每 5 分钟、回到前台时再调一次 __skyTint。改颜色就改 D / N 两张表。
	(() => {
		const D = [
			[6, [240, 170, 120, 0.16], [240, 150, 150, 0.1]],
			[8.5, [31, 135, 181, 0.11], [240, 150, 150, 0]],
			[15, [31, 135, 181, 0.11], [240, 150, 170, 0]],
			[17, [140, 120, 220, 0.11], [240, 150, 170, 0.1]],
			[18, [230, 140, 160, 0.14], [245, 180, 120, 0.12]],
		];
		const N = [
			[18, [150, 110, 230, 0.16], [230, 110, 150, 0.12]],
			[20, [140, 120, 230, 0.09], [176, 162, 255, 0.05]],
			[23, [140, 120, 230, 0], [176, 162, 255, 0]],
			[27, [70, 120, 200, 0], [78, 217, 173, 0]],
			[29, [70, 120, 200, 0.07], [78, 217, 173, 0.08]],
			[30, [90, 150, 220, 0.12], [110, 220, 200, 0.13]],
		];
		const along = (K, h) => {
			let i = 0;
			while (i < K.length - 2 && h > K[i + 1][0]) i++;
			const a = K[i];
			const b = K[i + 1];
			const t = Math.min(1, Math.max(0, (h - a[0]) / (b[0] - a[0])));
			return [1, 2].map(
				(j) => `rgba(${a[j].map((v, k) => (k < 3 ? Math.round(v + (b[j][k] - v) * t) : (v + (b[j][k] - v) * t).toFixed(3))).join(',')})`,
			);
		};
		window.__skyTint = () => {
			const now = new Date();
			const h = now.getHours() + now.getMinutes() / 60;
			const [dTop, dHor] = along(D, h >= 6 && h < 18 ? h : 12);
			const [nTop, nHor] = along(N, h >= 18 ? h : h < 6 ? h + 24 : 25);
			const s = document.documentElement.style;
			s.setProperty('--sky-top', dTop);
			s.setProperty('--sky-hor', dHor);
			s.setProperty('--sky-top-n', nTop);
			s.setProperty('--sky-hor-n', nHor);
		};
		window.__skyTint();
	})();
</script>

<Font cssVariable="--font-display" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
