---
// 底图上偶尔经过的小东西（挂在 Footer.astro 里，所以每一页都有）：
//   飞机，3–5 分钟一趟：日间是高空的一个小点拖两道长尾迹；夜间是红眼航班——一闪一闪的红灯加一颗小白灯
//   潮水，6–10 分钟一次：又宽又矮的一片水贴着底边从右下角斜着滑进来、再退回去，一次两道；夜间是荧光海
//   少见的那样，10–15 分钟一次：日间按季节飘东西（3–4 月嫩叶、5–8 月康乃馨、9–11 月枫叶、12–2 月雪花，有风时一两片会打个小旋）；夜间一阵流星雨
// 各管各的（2026-10-17 她说要随机性，和苦昼短一样）：三样按自己的节奏排，撞上了就一起出现，不再一次只放一样。
// 博客只放这三样，不加苦昼短的彩虹和极光（太霓虹）。
// 平时只挂一个定时器，没有常驻的动画；东西只动 transform / opacity，放完就拿掉。
// 另外每 5 分钟（和回到前台时）让 BaseHead.astro 里的 __skyTint 重算一次天色，跟着钟点慢慢变。
// 页面在后台、系统要求减少动态时不放。这一层和底图的两层同在最底下（z-index: -1），夹在静态层和云 / 亮星之间，从文字后面过。
---

<div id="sky-ev" aria-hidden="true"></div>

<style is:global>
	#sky-ev {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}
	.sky-ev {
		position: absolute;
		left: 0;
		top: 0;
		will-change: transform;
	}
	/* 头在右端，绕着头转向；位置和走法都是脚本给的 transform */
	.sky-plane,
	.sky-redeye {
		display: flex;
		align-items: center;
		transform-origin: 100% 50%;
	}
	.sky-trails {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.sky-trails b {
		display: block;
		width: 130px;
		height: 1px;
		background: linear-gradient(to left, color-mix(in srgb, var(--tx) 30%, transparent), transparent);
	}
	.sky-dot {
		width: 4px;
		height: 4px;
		margin-left: 1px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--tx) 52%, transparent);
	}
	.sky-red {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: #ff5a6e;
		animation: sky-blink 1.2s steps(1) infinite;
	}
	.sky-white {
		width: 2px;
		height: 2px;
		margin-left: 3px;
		border-radius: 50%;
		background: #efecf6;
		opacity: 0.8;
	}
	/* 四季飘的东西：样子是脚本里的 svg */
	.sky-fall svg {
		display: block;
		width: 100%;
	}
	.sky-meteor {
		height: 1.3px;
		border-radius: 2px;
		background: linear-gradient(to right, rgba(200, 230, 255, 0), rgba(226, 242, 255, 0.92));
		transform-origin: 100% 50%;
	}
	/* 潮水：贴在右下角的一片，画在 1000 × 100 的格子里横向拉开，线宽不跟着拉 */
	.sky-tide {
		left: auto;
		top: auto;
		right: 0;
		bottom: 0;
		transform-origin: 100% 100%;
	}
	.sky-tide svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.sky-tide path {
		vector-effect: non-scaling-stroke;
	}
	@keyframes sky-blink {
		0%,
		16% {
			opacity: 1;
		}
		17%,
		100% {
			opacity: 0.12;
		}
	}
</style>

<script>
	const host = document.getElementById('sky-ev');
	const reduce = matchMedia('(prefers-reduced-motion: reduce)');
	const R = Math.random;
	const pick = ([a, b]: number[]) => a + (b - a) * R();

	// ---------- 排班 ----------
	type Kind = 'plane' | 'tide' | 'rare';
	const GAPS: Record<Kind, number[]> = { plane: [180, 300], tide: [360, 600], rare: [600, 900] }; // 两趟之间隔多久（秒）
	const ORDER: Kind[] = ['rare', 'tide', 'plane'];
	const between = (range: number[]) => pick(range) * 1000;
	// 刚打开时第一趟飞机、第一道潮水来得早一点：看一两分钟就走的人也见得到
	const due: Record<Kind, number> = {
		plane: Date.now() + between([20, 60]),
		tide: Date.now() + between([60, 180]),
		rare: Date.now() + between(GAPS.rare),
	};
	let timer = 0;
	let serial = 0;

	const night = () => document.documentElement.dataset.theme === 'dark';
	const allowed = () => !reduce.matches && document.visibilityState === 'visible';
	// 几月飘什么（用读者设备上的当地日期）
	const seasonNow = () => {
		const m = new Date().getMonth() + 1;
		return m >= 3 && m <= 4 ? 'spring' : m >= 5 && m <= 8 ? 'summer' : m >= 9 && m <= 11 ? 'autumn' : 'winter';
	};

	// ---------- 画 ----------
	function piece(cls: string, html = '') {
		const el = document.createElement('span');
		el.className = 'sky-ev ' + cls;
		el.innerHTML = html;
		host!.appendChild(el);
		return el;
	}

	// 沿一条略斜的直线横穿，头朝前（尾迹拖在后面），speed 是每秒多少像素；返回要多久（毫秒）。位置都按「头在哪」算
	function cross(cls: string, html: string, speed: number) {
		const el = piece(cls, html);
		const W = innerWidth;
		const H = innerHeight;
		const w = el.offsetWidth;
		const ltr = R() < 0.5;
		const y0 = H * (0.1 + R() * 0.45);
		const y1 = y0 + (R() * 0.12 - 0.09) * H;
		const x0 = ltr ? -20 : W + 20;
		const x1 = ltr ? W + w + 20 : -w - 20;
		const turn = ` rotate(${((Math.atan2(y1 - y0, x1 - x0) * 180) / Math.PI).toFixed(2)}deg)`;
		const at = (x: number, y: number) => ({ transform: `translate(${(x - w).toFixed(0)}px,${y.toFixed(0)}px)${turn}` });
		const ms = Math.round((Math.hypot(x1 - x0, y1 - y0) / speed) * 1000);
		el.animate([at(x0, y0), at(x1, y1)], { duration: ms, easing: 'linear' }).onfinish = () => el.remove();
		return ms;
	}

	// 四季飘的东西：n 几片，size 多宽（px），secs 从顶落到底要几秒，sway 左右摆多少，spin 一路转多少度，colors 三套颜色，svg 画一片
	type Tone = string | string[];
	const carnation = (c: Tone) =>
		`<svg viewBox="0 0 24 28"><path d="M9.2 17.2h5.6l-1.3 9h-3z" fill="#8fc784"/><path d="M9.2 17.2 7.6 15.4 10 16.2 12 14.8 14 16.2 16.4 15.4 14.8 17.2z" fill="#7ab46e"/>` +
		`<path d="M12 18 2.2 9.4 4.4 8.8 3.6 6 6.2 6.5 6.3 3.6 8.7 4.8 9.7 2 12 3.8 14.3 2 15.3 4.8 17.7 3.6 17.8 6.5 20.4 6 19.6 8.8 21.8 9.4Z" fill="${c[0]}"/>` +
		`<path d="M12 18 5.6 10.6 7.6 10.4 7.2 8 9.4 8.6 10 6.2 12 7.6 14 6.2 14.6 8.6 16.8 8 16.4 10.4 18.4 10.6Z" fill="${c[2]}"/>` +
		`<path d="M12 17.5 8.2 7M12 17.5V5M12 17.5 15.8 7" stroke="${c[1]}" stroke-width=".7" stroke-linecap="round" opacity=".6"/></svg>`;
	const SEASONS: Record<string, { n: number; size: number[]; secs: number[]; sway: number; spin: number[]; colors: Tone[]; svg: (c: Tone) => string }> = {
		spring: {
			n: 6,
			size: [11, 15],
			secs: [14, 19],
			sway: 22,
			spin: [300, 500],
			colors: ['#c3e59a', '#aedb80', '#d8efb8'],
			svg: (c) => `<svg viewBox="0 0 20 12"><path d="M1 6C5 0 14 0 19 6C14 12 5 12 1 6Z" fill="${c}"/><path d="M3 6H17" stroke="rgba(110,160,80,.5)" stroke-width=".8"/></svg>`,
		},
		summer: {
			n: 6,
			size: [14, 19],
			secs: [15, 20],
			sway: 14,
			spin: [110, 200],
			colors: [
				['#f29ab6', '#e0718f', '#f9c6d6'],
				['#ee88a8', '#d6628a', '#f7b8cc'],
				['#fdf1f5', '#f29ab6', '#fbdbe5'],
			],
			svg: carnation,
		},
		autumn: {
			n: 5,
			size: [13, 18],
			secs: [16, 22],
			sway: 30,
			spin: [300, 500],
			colors: ['#e4794a', '#d65f45', '#efb055'],
			svg: (c) =>
				`<svg viewBox="0 0 24 24"><path d="M12 1 14 6 17.5 4.5 16.5 9.5 22 8.5 19.5 12 22.5 14 16 15.5 16.8 18.5 12.6 17.6V23H11.4V17.6L7.2 18.5 8 15.5 1.5 14 4.5 12 2 8.5 7.5 9.5 6.5 4.5 10 6Z" fill="${c}"/></svg>`,
		},
		winter: {
			n: 9,
			size: [9, 13],
			secs: [20, 28],
			sway: 10,
			spin: [60, 120],
			colors: ['#9cc9ea', '#b4d7f0', '#8cbde4'],
			svg: (c) =>
				`<svg viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8" stroke-linecap="round">` +
				[0, 60, 120, 180, 240, 300].map((a) => `<path transform="rotate(${a} 12 12)" d="M12 12V2.5M12 6 9.6 3.8M12 6 14.4 3.8"/>`).join('') +
				'</svg>',
		},
	};

	// 这一季的东西从上往下斜着飘；有风：其中一两片落到半路绕一个小圈再接着落（绕圈那两秒多里几乎不往下掉，不然屏幕一高，圈就被下落拉成一道弯）
	function fall(season?: string) {
		const S = SEASONS[season || ''] || SEASONS[seasonNow()];
		const W = innerWidth;
		const H = innerHeight;
		const STEPS = 24;
		const RING = 12;
		const first = Math.floor(R() * S.n);
		const second = R() < 0.6 ? (first + 2 + Math.floor(R() * (S.n - 3))) % S.n : -1;
		let longest = 0;
		for (let i = 0; i < S.n; i++) {
			const el = piece('sky-fall', S.svg(S.colors[i % S.colors.length]));
			const loop = i === first || i === second;
			el.style.width = pick(S.size).toFixed(1) + 'px';
			const x = W * (0.04 + R() * 0.72);
			const dx = W * (0.07 + R() * 0.1);
			const r = R() * 360;
			const spin = pick(S.spin);
			const base = pick(S.secs) * 1000;
			const whirl = loop ? 2400 : 0;
			const total = base + whirl;
			const at = 0.3 + R() * 0.25;
			const ring = 18 + R() * 6;
			const frame = (t: number, ox: number, oy: number, turn: number, ms: number) => ({
				transform: `translate(${(x + dx * t + Math.sin(t * 6.3) * S.sway + ox).toFixed(1)}px,${(-28 + (H + 56) * t + oy).toFixed(1)}px) rotate(${(r + spin * t + turn).toFixed(0)}deg)`,
				offset: Math.min(1, ms / total),
			});
			const frames: Keyframe[] = [];
			let whirled = false;
			for (let k = 0; k <= STEPS; k++) {
				const t = k / STEPS;
				if (!loop || t < at) {
					frames.push(frame(t, 0, 0, 0, t * base));
					continue;
				}
				if (!whirled) {
					// 到了起风的地方：原地绕一圈（顺手往前、往下带一点），转一整圈身
					for (let q = 0; q <= RING; q++) {
						const p = q / RING;
						const th = 2 * Math.PI * p;
						frames.push(frame(at, ring * Math.sin(th) + 10 * p, ring * (Math.cos(th) - 1) + 14 * p, 360 * p, at * base + whirl * p));
					}
					whirled = true;
				}
				frames.push(frame(t, 10, 14, 360, t * base + whirl));
			}
			const delay = i * 750;
			el.animate(frames, { duration: total, delay, easing: 'linear', fill: 'backwards' }).onfinish = () => el.remove();
			longest = Math.max(longest, total + delay);
		}
		return Math.round(longest);
	}

	// 流星雨：十颗左右（窄屏少几颗），都朝左下，八九秒里陆续划过
	function meteors() {
		const W = innerWidth;
		const H = innerHeight;
		const a = (150 * Math.PI) / 180;
		const n = W < 640 ? 7 : 10;
		let longest = 0;
		for (let i = 0; i < n; i++) {
			const el = piece('sky-meteor');
			const len = 46 + R() * 60;
			const x = W * (0.25 + R() * 0.8);
			const y = -10 + R() * H * 0.45;
			const d = 200 + R() * 140;
			el.style.width = len.toFixed(0) + 'px';
			const ms = 900 + R() * 500;
			const delay = (i * 8000) / n + R() * 500;
			el.animate(
				[
					{ transform: `translate(${x.toFixed(0)}px,${y.toFixed(0)}px) rotate(150deg)`, opacity: 0 },
					{ opacity: 1, offset: 0.2 },
					{ opacity: 1, offset: 0.7 },
					{ transform: `translate(${(x + Math.cos(a) * d).toFixed(0)}px,${(y + Math.sin(a) * d).toFixed(0)}px) rotate(150deg)`, opacity: 0 },
				],
				{ duration: ms, delay, easing: 'ease-in', fill: 'both' },
			).onfinish = () => el.remove();
			longest = Math.max(longest, ms + delay);
		}
		return Math.round(longest);
	}

	// ---------- 潮水 ----------
	// 水面的高低（0–1，x 从左到右）：左边贴地，往右下角慢慢高起来
	const tideTop = (x: number) => 0.2 + 0.8 * Math.pow(x, 1.7);
	// 浪边每一道现算：沿着水面取点、各自随机矮一点，再连成顺的曲线——不会两次一样
	function tideEdge() {
		const n = 18;
		const p: number[][] = [];
		for (let i = 0; i <= n; i++) {
			const x = i / n;
			p.push([x * 1000, 100 - 100 * tideTop(x) * (0.8 + R() * 0.2)]);
		}
		p[0][1] = 100;
		p[1][1] = 96;
		let d = 'M0 100';
		for (let i = 1; i < n; i++) {
			d += `Q${p[i][0].toFixed(0)} ${p[i][1].toFixed(1)} ${((p[i][0] + p[i + 1][0]) / 2).toFixed(0)} ${((p[i][1] + p[i + 1][1]) / 2).toFixed(1)}`;
		}
		return `${d}L1000 ${p[n][1].toFixed(1)}`;
	}
	const line = (d: string, stroke: string, width: number, more = '') =>
		`<path d="${d}" fill="none" stroke="${stroke}" stroke-width="${width}" stroke-linecap="round" ${more}/>`;
	const GLOW = 'style="filter:drop-shadow(0 0 3px #6fd8ff) drop-shadow(0 0 8px #4a8cff)"';
	// 进来快、停一下、退得慢：从右下角屏幕外斜着滑到位，再斜着退回去
	const SWASH = [
		{ transform: 'translate(72%,115%)', easing: 'cubic-bezier(.15,.7,.3,1)' },
		{ transform: 'translate(0,0)', offset: 0.3, easing: 'ease-in-out' },
		{ transform: 'translate(-1.5%,5%)', offset: 0.42, easing: 'cubic-bezier(.5,0,.8,.5)' },
		{ transform: 'translate(64%,118%)' },
	];

	// 一道：后面一层淡的（晚一点，叠出层次）、前面一层带浪边的、退走后留在最远处的那一道（泡沫 / 荧光点，慢慢淡掉）
	function wash(dark: boolean, width: number, height: number, delay: number) {
		const e = tideEdge();
		const body = `${e}L1000 100L0 100Z`;
		const id = `sky-g${++serial}`;
		const layer = (w: number, h: number, html: string) => {
			const el = piece('sky-tide', `<svg viewBox="0 0 1000 100" preserveAspectRatio="none">${html}</svg>`);
			el.style.width = w + '%';
			el.style.height = h.toFixed(0) + 'px';
			return el;
		};
		const grad = (top: string, bottom: string) =>
			`<linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${top}"/><stop offset="1" stop-color="${bottom}"/></linearGradient><path d="${body}" fill="url(#${id})"/>`;
		let front: HTMLElement;
		let back: HTMLElement;
		let left: HTMLElement;
		if (dark) {
			// 荧光海：水几乎看不见，浪边是发光的青蓝细线，水里一道道忽明忽暗的小横杠
			let dashes = '';
			for (let i = 0; i < 11; i++) {
				const x = 0.2 + R() * 0.76;
				const y0 = 100 - 100 * tideTop(x) * 0.8 + 16;
				const y = y0 + R() * Math.max(4, 92 - y0);
				dashes += `<rect x="${(x * 1000 - 30).toFixed(0)}" y="${y.toFixed(0)}" width="${(18 + R() * 54).toFixed(0)}" height="3.4" rx="1.6" fill="#a8f0ff"/>`;
			}
			back = layer(width * 0.9, height * 0.8, `<path d="${body}" fill="rgba(70,130,220,.1)"/>`);
			front = layer(width, height, `${grad('rgba(70,130,220,.07)', 'rgba(50,100,190,.22)')}<g ${GLOW}>${line(e, '#8fe9ff', 2)}</g>${dashes}`);
			left = layer(
				width,
				height,
				`<g ${GLOW}>${line(e, '#c4f6ff', 2.2, 'stroke-dasharray=".1 9"')}${line(e, '#a8f0ff', 1.6, 'stroke-dasharray=".1 23 .1 13 .1 31" transform="translate(6 14)"')}</g>`,
			);
			front.querySelectorAll('rect').forEach((r) =>
				r.animate([{ opacity: 0.1 }, { opacity: 1 }, { opacity: 0.25 }, { opacity: 0.9 }, { opacity: 0.1 }], {
					duration: 900 + R() * 900,
					iterations: Infinity,
					delay: -R() * 900,
				}),
			);
		} else {
			// 日间：海水色从浪边到底边由浅到深；白浪边两侧各压一道错开的玫瑰线和蓝线；水里两道断断续续的白水纹，浪边下一串碎泡沫点
			back = layer(width * 0.9, height * 0.8, `<path d="${body}" fill="rgba(100,190,220,.13)"/>`);
			front = layer(
				width,
				height,
				grad('rgba(130,205,225,.16)', 'rgba(80,170,205,.32)') +
					line(e, 'rgba(255,255,255,.6)', 1, 'stroke-dasharray="46 30 18 52" transform="translate(10 24)"') +
					line(e, 'rgba(255,255,255,.45)', 1, 'stroke-dasharray="26 44 60 36" transform="translate(-14 48)"') +
					line(e, 'rgba(240,140,170,.45)', 1, 'transform="translate(-3 -5)"') +
					line(e, 'rgba(90,150,220,.45)', 1, 'transform="translate(3 5)"') +
					line(e, '#fff', 2.6) +
					line(e, 'rgba(255,255,255,.9)', 2.6, 'stroke-dasharray=".1 11 .1 19 .1 7 .1 26" transform="translate(4 9)"'),
			);
			left = layer(
				width,
				height,
				`<path d="${body}" fill="rgba(100,190,220,.07)"/>` +
					line(e, 'rgba(255,255,255,.95)', 1.8, 'stroke-dasharray="2 7"') +
					line(e, 'rgba(90,150,220,.35)', 1, 'stroke-dasharray="2 7" transform="translate(2 4)"'),
			);
		}
		const life = 9000;
		back.animate(SWASH, { duration: life, delay: delay + 380, fill: 'both' }).onfinish = () => back.remove();
		front.animate(SWASH, { duration: life, delay, fill: 'both' }).onfinish = () => front.remove();
		left.animate([{ opacity: 0 }, { opacity: 0, offset: 0.3 }, { opacity: 0.9, offset: 0.36 }, { opacity: 0, offset: 0.9 }, { opacity: 0 }], {
			duration: life,
			delay,
			fill: 'both',
		}).onfinish = () => left.remove();
		return delay + life + 380;
	}

	// 一次两道，后一道短一点、矮一点。高度跟着屏幕：宽屏约屏高的 7%，窄屏约 5.5%
	function tide(dark: boolean) {
		const H = innerHeight;
		const h = innerWidth <= 760 ? Math.max(30, Math.min(48, H * 0.055)) : Math.max(34, Math.min(64, H * 0.07));
		wash(dark, 94, h, 0);
		return wash(dark, 76, h * 0.78, 5600);
	}

	const SHOWS: Record<string, (how?: string) => number> = {
		plane: () => cross('sky-plane', '<span class="sky-trails"><b></b><b></b></span><span class="sky-dot"></span>', 45),
		redeye: () => cross('sky-redeye', '<span class="sky-red"></span><span class="sky-white"></span>', 38),
		fall,
		meteors,
		tide: (how) => tide(how ? how === 'night' : night()),
	};
	function show(kind: string, how?: string) {
		SHOWS[kind](how);
	}

	const arm = (ms: number) => {
		clearTimeout(timer);
		timer = window.setTimeout(tick, Math.max(1000, ms));
	};
	const next = () => Math.min(due.plane, due.tide, due.rare) - Date.now();

	// 到点了的全放（撞在一起就一起出现），各自排到下一趟
	function tick() {
		if (!allowed()) return; // 回到前台时再排（下面的 visibilitychange）；减少动态的就一直不放
		const now = Date.now();
		for (const kind of ORDER.filter((k) => due[k] <= now)) {
			due[kind] = now + between(GAPS[kind]);
			show(kind === 'tide' ? 'tide' : kind === 'plane' ? (night() ? 'redeye' : 'plane') : night() ? 'meteors' : 'fall');
		}
		arm(next());
	}

	// 天色跟着钟点慢慢变：每 5 分钟、回到前台时重算一次（算法在 BaseHead.astro 开头）
	const retint = () => (window as unknown as { __skyTint?: () => void }).__skyTint?.();
	setInterval(() => document.visibilityState === 'visible' && retint(), 5 * 60 * 1000);

	if (host) {
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState !== 'visible') clearTimeout(timer); // 在后台：定时器也不挂
			else {
				retint();
				arm(next());
			}
		});
		// 换了日夜：正在放的那样直接拿掉（日间的飞机不该飞进夜里）
		new MutationObserver(() => {
			host.querySelectorAll('.sky-ev').forEach((el) => el.remove());
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
		// 预览时手动放一样看样子，在控制台里：
		//   dispatchEvent(new CustomEvent('sky-show', { detail: 'plane' }))        plane / redeye / meteors / fall / tide
		//   dispatchEvent(new CustomEvent('sky-show', { detail: 'fall:summer' }))  指定季节 spring / summer / autumn / winter；潮水是 tide:day / tide:night
		addEventListener('sky-show', (e) => {
			const [kind, how] = String((e as CustomEvent).detail).split(':');
			if (SHOWS[kind]) show(kind, how);
		});
		arm(next());
	}
</script>
