---
// 界面截图：日间、夜间各一张（src/figures/<name>-light.png 和 <name>-dark.png），跟着全站主题只显示对应的那张。
// 用法（.mdx 文章）：import Shot from '../../components/Shot.astro';  然后  <Shot name="tb-ui-today" alt="说明" />
// phone = 手机截图，窄一些；几张并排就包一层 <div class="shot-row">。没有夜间那张时两种主题都用日间的。
// both = 日夜两张并排都显示（讲外观时用），不跟主题切换。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const shots = import.meta.glob<{ default: ImageMetadata }>('../figures/*.png', { eager: true });

interface Props {
	name: string;
	alt: string;
	phone?: boolean;
	both?: boolean;
}
const { name, alt, phone = false, both = false } = Astro.props;
const light = shots[`../figures/${name}-light.png`]?.default;
if (!light) throw new Error(`Shot: 没有这张图 src/figures/${name}-light.png`);
const dark = shots[`../figures/${name}-dark.png`]?.default ?? light;
const widths = phone ? [390, 780] : [720, 1440];
const sizes = phone ? '300px' : '(min-width: 720px) 664px, 100vw';
---

{
	both ? (
		<div class="shot-pair">
			<figure class="shot">
				<Image src={light} alt={`${alt} (day)`} widths={[480, 960]} sizes="(min-width: 720px) 326px, 50vw" />
				<figcaption>Day</figcaption>
			</figure>
			<figure class="shot">
				<Image src={dark} alt={`${alt} (night)`} widths={[480, 960]} sizes="(min-width: 720px) 326px, 50vw" />
				<figcaption>Night</figcaption>
			</figure>
		</div>
	) : (
		<figure class:list={['shot', { phone }]}>
			<Image class="shot-light" src={light} alt={alt} widths={widths} sizes={sizes} />
			<Image class="shot-dark" src={dark} alt={alt} widths={widths} sizes={sizes} />
		</figure>
	)
}

<style>
	.shot {
		margin: 1.75rem 0;
	}
	.shot.phone {
		max-width: 300px;
		margin-inline: auto;
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border: 1px solid var(--line);
		border-radius: 10px;
	}
	.shot :global(.shot-dark),
	:global([data-theme='dark']) .shot :global(.shot-light) {
		display: none;
	}
	:global([data-theme='dark']) .shot :global(.shot-dark) {
		display: block;
	}
	.shot-pair {
		display: flex;
		gap: 0.75rem;
		margin: 1.75rem 0;
	}
	.shot-pair .shot {
		flex: 1 1 0;
		margin: 0;
	}
	.shot figcaption {
		margin-top: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-align: center;
		color: var(--tx-2);
	}
	:global(.shot-row) {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin: 1.75rem 0;
	}
	:global(.shot-row) .shot {
		flex: 1 1 0;
		margin: 0;
	}
</style>
