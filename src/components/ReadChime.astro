---
// 读完的小彩蛋：滚到文末（转载声明那一行进入视野）时，一只风铃从右上角飘进来，挂在顶上进度线底下，
// 往这边晃两下就淡掉，约 3.6 秒，每次打开页面只放一次。
// 风铃的样子：一颗玻璃铃，铃上画着面对面的两只小鸟——暖色的云雀（头顶一撮冠毛）和薰衣草色的夜莺（尾巴翘起），
// 对着「致云雀 / 夜莺颂」两个栏目、也对着白天和夜里；下面垂一条纸签，上面是页脚那五颗彩点。纸签比铃晃得晚一点。
// 平时什么都不挂：IntersectionObserver 盯着文末，放的时候才临时放一个元素进来、放完拿掉（el.animate 只动 transform / opacity）。
// 只在进度线能显示的浏览器里放（它挂在线底下）；系统要求减少动态、页面在后台、还没往下滚过（比如一打开就在文末）时不放。
// 想换样子：改下面的 CHIME（svg 画在 60 × 150 的格子里，挂点在 30,0）和 .read-chime 里的几个颜色变量。
---

<style is:global>
	.read-chime {
		--glass: rgba(190, 225, 240, 0.5);
		--gline: rgba(38, 35, 46, 0.3);
		--hi: rgba(255, 255, 255, 0.85);
		--paper: #fff8ec;
		--pline: rgba(38, 35, 46, 0.18);
		position: fixed;
		top: 2px;
		right: clamp(16px, 5vw, 64px);
		z-index: 47;
		width: 60px;
		pointer-events: none;
		transform-origin: 30px 0;
	}
	[data-theme='dark'] .read-chime {
		--glass: rgba(107, 198, 240, 0.16);
		--gline: rgba(239, 236, 246, 0.38);
		--hi: rgba(255, 255, 255, 0.5);
		--paper: #2a2535;
		--pline: rgba(239, 236, 246, 0.22);
	}
	.read-chime svg {
		display: block;
		width: 100%;
		overflow: visible;
	}
	.read-chime .rc-strip {
		transform-box: view-box;
		transform-origin: 30px 84px;
	}
</style>

<script>
	const CHIME = `<svg viewBox="0 0 60 150" aria-hidden="true">
<path d="M30 0V35" stroke="var(--gline)" stroke-width="1"/>
<circle cx="30" cy="35" r="1.8" fill="var(--coral)"/>
<path d="M8 66C8 46 17 37 30 37C43 37 52 46 52 66Z" fill="var(--glass)" stroke="var(--gline)" stroke-width=".9"/>
<ellipse cx="30" cy="66" rx="22" ry="2.8" fill="var(--glass)" stroke="var(--gline)" stroke-width=".9"/>
<path d="M15 60C15 50 20 43 27 41" fill="none" stroke="var(--hi)" stroke-width="1.6" stroke-linecap="round"/>
<g fill="var(--sun)"><path d="M14.6 54.4 11.4 52.8 12 56.4Z"/><ellipse cx="19.6" cy="55" rx="5.4" ry="3.8"/><circle cx="24" cy="51.8" r="2.8"/><path d="M22.8 49.4 24 46.6 25.2 49.6Z"/></g>
<path d="M26.6 51.4 28.6 52.2 26.6 53Z" fill="var(--coral)"/><circle cx="24.7" cy="51.4" r=".6" fill="var(--bg)"/>
<g fill="var(--lav)"><path d="M44.4 54.6 48.6 49.4 45.8 56.2Z"/><ellipse cx="40" cy="55.4" rx="5" ry="3.2"/><circle cx="35.8" cy="52.6" r="2.4"/></g>
<path d="M33.6 52.2 31.6 52.8 33.6 53.4Z" fill="var(--coral)"/><circle cx="35.2" cy="52.2" r=".55" fill="var(--bg)"/>
<g class="rc-strip"><path d="M30 66V84" stroke="var(--gline)" stroke-width=".9"/><circle cx="30" cy="76" r="2.2" fill="var(--glass)" stroke="var(--gline)" stroke-width=".7"/>
<rect x="22.5" y="84" width="15" height="56" rx="1.5" fill="var(--paper)" stroke="var(--pline)" stroke-width=".8"/>
<circle cx="30" cy="97" r="1.9" fill="var(--coral)"/><circle cx="30" cy="105" r="1.9" fill="var(--sun)"/><circle cx="30" cy="113" r="1.9" fill="var(--mint)"/><circle cx="30" cy="121" r="1.9" fill="var(--sky)"/><circle cx="30" cy="129" r="1.9" fill="var(--lav)"/></g>
</svg>`;

	const ring = () => {
		if (document.visibilityState !== 'visible') return;
		const el = document.createElement('div');
		el.className = 'read-chime';
		el.setAttribute('aria-hidden', 'true');
		el.innerHTML = CHIME;
		document.body.append(el);
		// 从右上角飘进来（一路晃着），到位后往这边晃两下、越晃越小，最后往上一收淡掉
		const swing = el.animate(
			[
				{ transform: 'translate(90px, -46px) rotate(22deg)', opacity: 0 },
				{ transform: 'translate(0, 0) rotate(-14deg)', opacity: 1, offset: 0.26 },
				{ transform: 'translate(0, 0) rotate(10deg)', offset: 0.42 },
				{ transform: 'translate(0, 0) rotate(-8deg)', offset: 0.57 },
				{ transform: 'translate(0, 0) rotate(5deg)', offset: 0.7 },
				{ transform: 'translate(0, 0) rotate(-2deg)', opacity: 1, offset: 0.8 },
				{ transform: 'translate(0, -12px) rotate(0deg)', opacity: 0 },
			],
			{ duration: 3600, easing: 'ease-in-out', fill: 'forwards' },
		);
		// 纸签晚半拍，跟着铃反着摆
		el.querySelector('.rc-strip')?.animate(
			[
				{ transform: 'rotate(0deg)' },
				{ transform: 'rotate(12deg)', offset: 0.3 },
				{ transform: 'rotate(-10deg)', offset: 0.46 },
				{ transform: 'rotate(8deg)', offset: 0.61 },
				{ transform: 'rotate(-5deg)', offset: 0.74 },
				{ transform: 'rotate(2deg)', offset: 0.86 },
				{ transform: 'rotate(0deg)' },
			],
			{ duration: 3600, easing: 'ease-in-out' },
		);
		swing.finished.then(() => el.remove());
	};

	const end = document.querySelector('article .colophon');
	if (
		end &&
		CSS.supports('animation-timeline: scroll()') &&
		!matchMedia('(prefers-reduced-motion: reduce)').matches
	) {
		let scrolled = false;
		addEventListener('scroll', () => (scrolled = true), { once: true, passive: true });
		const io = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting || !scrolled) return;
			io.disconnect();
			ring();
		});
		io.observe(end);
	}
</script>
