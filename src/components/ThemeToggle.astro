<button id="theme-toggle" aria-label="切换亮暗模式" title="切换亮暗模式">
	<svg
		class="sun"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path
			d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.3 11.3 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path>
	</svg>
	<svg
		class="moon"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
	</svg>
</button>

<style>
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: none;
		cursor: pointer;
		padding: 0.45rem;
		border-radius: 50%;
		color: var(--tx-2);
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}
	button:hover {
		color: var(--sun);
		background: color-mix(in srgb, var(--sun) 14%, transparent);
	}
	.moon {
		display: none;
	}
	:global([data-theme='dark']) .sun {
		display: none;
	}
	:global([data-theme='dark']) .moon {
		display: block;
	}
</style>

<script>
	// 切换时的过场：整页慢慢淡过去（同文档 View Transition，只在点这个按钮时用），底边泛一阵霞光（.dusk，样式在 global.css）。
	// 系统要求减少动态就直接换；浏览器不支持过渡时也直接换，霞光照常泛一下
	const root = document.documentElement;
	const btn = document.getElementById('theme-toggle');
	const calm = matchMedia('(prefers-reduced-motion: reduce)');
	btn?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		const apply = () => {
			root.dataset.theme = next;
			localStorage.setItem('theme', next);
		};
		if (calm.matches) return apply();
		document.querySelector('.dusk')?.remove();
		const glow = document.createElement('div');
		glow.className = 'dusk';
		glow.dataset.k = next === 'dark' ? 'dusk' : 'dawn'; // 切到夜间是晚霞，切到日间是朝霞
		glow.setAttribute('aria-hidden', 'true');
		const swap = () => {
			apply();
			document.body.append(glow);
			setTimeout(() => glow.remove(), 1800);
		};
		if (!document.startViewTransition) return swap();
		root.dataset.vt = 'theme';
		const vt = document.startViewTransition(swap);
		vt.ready.catch(() => {});
		vt.finished.finally(() => delete root.dataset.vt).catch(() => {});
	});
</script>
